{
  "$comment": "The Wall — Claude Code session settings. Deny rules are a seatbelt, not the safety rule: CLAUDE.md sections 6 and 7 are the safety rule.",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(./scripts/audit.sh)",
      "Bash(./scripts/drift.sh)",
      "Bash(./scripts/report.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add -u)",
      "Bash(git add test/:*)",
      "Bash(git add docs/:*)",
      "Bash(git add scripts/:*)",
      "Bash(git add .claude/:*)",
      "Bash(git add CLAUDE.md)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout master)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(gcloud run services update-traffic:*)",
      "Bash(gcloud secrets:*)",
      "Bash(./scripts/deploy.sh:*)",
      "Bash(npm run deploy:*)",
      "Read(./.scout.env)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./data/**)",
      "Edit(./.scout.env)",
      "Edit(./.env)",
      "Edit(./deploy.env)"
    ]
  }
}

# ── Obligatoire en production ────────────────────────────────────────
SOLANA_RPC_URL=            # Helius / Triton / QuickNode — endpoint privé
GATE_TOKEN=                # secret interne (Cloud Run ↔ preflight)
ADMIN_TOKEN=               # accès au back-office /admin
TREASURY_WALLET=           # adresse Solana qui encaisse les sièges
ANTHROPIC_API_KEY=         # modérateur + tape + reporter
ANTHROPIC_MODEL=claude-sonnet-5                  # agents de fond
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001   # modérateur (dans le checkout)

# ── Éditeur du site (LCEN) ───────────────────────────────────────────
# Aucun champ non renseigné n'est imprimé : pas de « [to be completed] ».
# Par défaut, une identité incomplète N'EMPÊCHE PAS la vente (décision
# opérateur du 03/09/2026) : le manque est TRACÉ, pas bloquant. Chaque
# siège vendu avec un manque écrit une ligne `sold_with_gaps` au journal
# d'audit, et /api/admin/ops liste les manques en permanence.
# SALES_REQUIRE_PUBLISHER=true bascule vers le refus (503 au checkout).
PUBLISHER_NAME=                 # ex: The Wall — NOM Prénom
PUBLISHER_LEGAL_FORM=           # ex: Entreprise individuelle (micro-entreprise)
PUBLISHER_SIREN=                # 9 chiffres, la somme de Luhn est vérifiée au boot
PUBLISHER_DIRECTOR=             # directeur de la publication (souvent la même personne)
PUBLISHER_ADDRESS=              # adresse publiée. Laisser vide SI ↓
PUBLISHER_ADDRESS_ON_REQUEST=   # true → « adresse communiquée sur demande » (voir DEPLOY.md)
PUBLISHER_VAT=                  # TVA intracom, seulement si assujetti
PUBLISHER_CONTACT=contact@thewallsol.com
PUBLISHER_HOST=Google Cloud EMEA Limited, Velasco, Clanwilliam Place, Dublin 2, Ireland
SALES_REQUIRE_PUBLISHER=false   # true = refuser la vente tant que l'identité est incomplète

# ── E-mail (Resend) ──────────────────────────────────────────────────
# Sans ces deux-là, un acheteur paie et ne reçoit pas de reçu. L'échec
# est enregistré (`email_not_configured`), le siège est attribué quand
# même : un paiement confirmé sur la chaîne ne dépend pas d'un e-mail.
RESEND_API_KEY=                 # console.resend.com → API Keys
MAIL_FROM=The Wall <contact@thewallsol.com>   # domaine VÉRIFIÉ chez Resend
MAIL_REPLY_TO=contact@thewallsol.com
MAIL_TIMEOUT_MS=6000

# ── Fortement recommandé ─────────────────────────────────────────────
SAFE_BROWSING_KEY=         # sans clé, tout lien est "unchecked" → refusé
STORAGE_BACKEND=firestore  # firestore | file | memory
PUBLIC_BASE_URL=https://thewall.example

# ── Interrupteurs ────────────────────────────────────────────────────
AGENTS_ENABLED=true
AGENT_MODERATOR_ENABLED=true
AGENT_TAPE_ENABLED=true
AGENT_REPORTER_ENABLED=true
AGENT_TAPE_SUPERVISED=true
AGENT_REPORTER_SUPERVISED=true

# ── Réglages du mur ──────────────────────────────────────────────────
SEAT_COUNT=24
SEAT_FLOOR_USD=50
SEAT_HOLD_MINUTES=20
GATE_BUDGET_MS=2000

# ── Règles dures (ne pas assouplir sans relire test/screener.test.js) ─
MAX_TOP_HOLDER_PCT=40
MIN_LP_USD=2500
FLAG_LP_USD=15000
FLAG_AGE_HOURS=24
FLAG_TOP_HOLDER_PCT=25

# ── Garde-fous de dépense ────────────────────────────────────────────
MODEL_CALLS_PER_HOUR=400
EXCLUDED_HOLDERS=          # CSV: burn address, LP vaults connus

# Réglages de déploiement — PAS DE SECRETS ICI.
# Les secrets vivent dans Secret Manager (voir DEPLOY.md §2).
# deploy.sh lit ce fichier automatiquement.

# Adresse Solana qui encaisse les sièges. Publique par nature :
# elle s'affiche sur chaque page de paiement.
export TREASURY_WALLET=7nTit2yrh9G2RT6Y4jUe6DXyjgweQY2CTX9mvKCRfhts

# Projet GCP (créé le 25/08/2026, 263 € de crédits jusqu'au 24/11/2026).
export PROJECT=project-3104b4c3-08fc-4468-848

# L'URL .run.app rendue par le premier déploiement, puis votre domaine.
export PUBLIC_BASE_URL=https://thewallsol.com

# Le compte de service qui fait tourner le mur. Google impose 6 à 30
# caractères pour un identifiant de compte de service — "wall" est refusé.
export SERVICE_ACCOUNT=wall-agents

# ── Réglages du mur ──────────────────────────────────────────────────
# Mis ici plutôt que dans un "services update" : le déploiement réécrit
# toutes les variables, et ce qui n'est pas dans ce fichier disparaît.
export SEAT_COUNT=24
export SEAT_FLOOR_USD=15
# Pour reprendre un siège : +10 % ou +5 $, le plus élevé des deux.
# Sans cet incrément, un siège se revend au centime près indéfiniment.
export MIN_INCREMENT_PCT=0.10
export MIN_INCREMENT_USD=5
export MAX_BID_USD=100000
# Cinq minutes : le temps d'ouvrir un portefeuille et de confirmer, pas
# le temps d'aller acheter du SOL. Un siège reservé est un siège que
# personne d'autre ne peut prendre.
export SEAT_HOLD_MINUTES=5

# Un siège acheté appartient à son acheteur pendant ce délai, quel que
# soit le montant offert par un tiers. Sans ça, payer 15 $ peut n'acheter
# que quatre minutes de mur. À ajuster sur ce que montre « Sièges repris ».
export SEAT_PROTECT_MINUTES=30

export REGION=europe-west1
export SERVICE=wall
export SCOUT_ROUND_LIMIT=24

# ── L'éditeur du site (LCEN) ─────────────────────────────────────────
# Rien de vide n'est imprimé — aucun « à compléter » en ligne.
#
# DÉCISION OPÉRATEUR DU 03/09/2026 : une identité incomplète n'empêche
# PAS la vente. Le manque est tracé, pas bloquant — chaque siège vendu
# avec un manque écrit `sold_with_gaps` au journal d'audit avec la liste
# de ce qui manquait CE JOUR-LÀ, et /api/admin/ops les liste en continu.
# Pour revenir au refus strict : SALES_REQUIRE_PUBLISHER=true.
#
# Ce fichier est versionné : n'y mettez que ce qui est déjà public.
export PUBLISHER_NAME="The Wall"
export PUBLISHER_LEGAL_FORM="Entreprise individuelle (micro-entreprise)"
# 9 chiffres. La somme de Luhn est vérifiée : un numéro mal recopié est
# refusé au démarrage plutôt qu'imprimé faux sur une page publique.
export PUBLISHER_SIREN=
export PUBLISHER_DIRECTOR=
# Deux voies, une seule à choisir :
#   - PUBLISHER_ADDRESS renseignée  → l'adresse est imprimée sur /terms
#   - PUBLISHER_ADDRESS_ON_REQUEST=true → la page dit qu'elle est
#     communiquée sur demande à contact@thewallsol.com
# Voir DEPLOY.md §8 : la seconde voie n'est pas sans risque juridique.
export PUBLISHER_ADDRESS=
export PUBLISHER_ADDRESS_ON_REQUEST=true
export PUBLISHER_VAT=
export PUBLISHER_CONTACT=contact@thewallsol.com
# true = la caisse refuse tant que l'identité est incomplète. false = on vend.
export SALES_REQUIRE_PUBLISHER=false

# ── E-mail ───────────────────────────────────────────────────────────
# La clé Resend est un SECRET (Secret Manager, voir DEPLOY.md §2.6).
# Ici, seulement ce qui est public. Le domaine de MAIL_FROM doit être
# vérifié chez Resend, sinon chaque envoi est rejeté en 403.
export MAIL_FROM="The Wall <contact@thewallsol.com>"
export MAIL_REPLY_TO=contact@thewallsol.com

# Réglages de déploiement — PAS DE SECRETS ICI.
# Les secrets vivent dans Secret Manager (voir DEPLOY.md §2).
# deploy.sh lit ce fichier automatiquement.

# Adresse Solana qui encaisse les sièges. Publique par nature :
# elle s'affiche sur chaque page de paiement.
export TREASURY_WALLET=7nTit2yrh9G2RT6Y4jUe6DXyjgweQY2CTX9mvKCRfhts

# Projet GCP (créé le 25/08/2026, 263 € de crédits jusqu'au 24/11/2026).
export PROJECT=project-3104b4c3-08fc-4468-848

# L'URL .run.app rendue par le premier déploiement, puis votre domaine.
export PUBLIC_BASE_URL=https://thewallsol.com

# Le compte de service qui fait tourner le mur. Google impose 6 à 30
# caractères pour un identifiant de compte de service — "wall" est refusé.
export SERVICE_ACCOUNT=wall-agents

# ── Réglages du mur ──────────────────────────────────────────────────
# Mis ici plutôt que dans un "services update" : le déploiement réécrit
# toutes les variables, et ce qui n'est pas dans ce fichier disparaît.
export SEAT_COUNT=24
export SEAT_FLOOR_USD=15
# Pour reprendre un siège : +10 % ou +5 $, le plus élevé des deux.
# Sans cet incrément, un siège se revend au centime près indéfiniment.
export MIN_INCREMENT_PCT=0.10
export MIN_INCREMENT_USD=5
export MAX_BID_USD=100000
# Cinq minutes : le temps d'ouvrir un portefeuille et de confirmer, pas
# le temps d'aller acheter du SOL. Un siège reservé est un siège que
# personne d'autre ne peut prendre.
export SEAT_HOLD_MINUTES=5

# Un siège acheté appartient à son acheteur pendant ce délai, quel que
# soit le montant offert par un tiers. Sans ça, payer 15 $ peut n'acheter
# que quatre minutes de mur. À ajuster sur ce que montre « Sièges repris ».
export SEAT_PROTECT_MINUTES=30

export REGION=europe-west1
export SERVICE=wall
export SCOUT_ROUND_LIMIT=24
